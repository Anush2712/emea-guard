EMEA_GUARD_DATABASE_URL=postgresql+psycopg://emea_guard:emea_guard@localhost:5432/emea_guard
EMEA_GUARD_JWT_SECRET=change-me-in-production
EMEA_GUARD_SEED_ON_STARTUP=true
EMEA_GUARD_CORS_ORIGINS=*
EMEA_GUARD_ENVIRONMENT=development
EMEA_GUARD_APP_BASE_URL=http://localhost:8080
# Number of proxies in front of the API that append X-Forwarded-For (0 = ignore the header)
EMEA_GUARD_TRUSTED_PROXY_HOPS=0
# Password reset email delivery (optional locally; required anywhere else). Either Resend (HTTPS) ...
EMEA_GUARD_RESEND_API_KEY=
# ... or SMTP
EMEA_GUARD_SMTP_HOST=
EMEA_GUARD_SMTP_PORT=587
EMEA_GUARD_SMTP_USERNAME=
EMEA_GUARD_SMTP_PASSWORD=
EMEA_GUARD_SMTP_FROM=EMEA Guard <no-reply@example.com>
